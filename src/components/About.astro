---
import personalData from '../data/personal.json';
---

<section id="about" class="py-24 bg-slate-900/30" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">

      <div class="text-center mb-12 reveal">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
          How I Work
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">
          About
        </h2>
      </div>

      <div class="card reveal" style="transition-delay: 0.15s;">
        <p class="text-lg text-slate-300 leading-relaxed mb-8">
          {personalData.aboutLong}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <div>
            <h3 class="text-white font-semibold mb-2">Acquire</h3>
            <p class="text-slate-400 text-sm">
              Paid search, landing pages, SEO, and lead-generation systems designed to create measurable demand.
            </p>
          </div>

          <div>
            <h3 class="text-white font-semibold mb-2">Measure</h3>
            <p class="text-slate-400 text-sm">
              Analytics, attribution, CRM tracking, and reporting that connect marketing activity to business outcomes.
            </p>
          </div>

          <div>
            <h3 class="text-white font-semibold mb-2">Build</h3>
            <p class="text-slate-400 text-sm">
              Independent digital products and acquisition systems that let me test these ideas in the real world.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#about .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>