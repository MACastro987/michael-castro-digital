---
import personalData from '../data/personal.json';
import siteData from '../data/site.json';

const currentYear = new Date().getFullYear();
---

<footer
  id="site-footer"
  style="background: var(--footer-bg); border-top: 1px solid var(--footer-border);"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl py-10">

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">

      <div>
        <p class="text-lg font-bold gradient-text">
          {personalData.name}
        </p>

        <p class="text-slate-500 text-sm mt-2 max-w-md">
          {siteData.tagline}
        </p>
      </div>

      <nav class="flex flex-wrap gap-6 text-sm" aria-label="Footer navigation">
        <a href="#about" class="footer-link">About</a>
        <a href="#projects" class="footer-link">Projects</a>
        <a href="https://softwaredecisionguide.com" target="_blank" rel="noopener" class="footer-link">
          Software Decision Guide
        </a>
        <a href="#contact" class="footer-link">Contact</a>
      </nav>

    </div>

    <div class="footer-divider my-8"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-slate-600">
      <p>© {currentYear} {personalData.name}</p>

      <div class="flex gap-4">
        <a href="/privacy" class="footer-link">Privacy</a>
        <a href="/terms" class="footer-link">Terms</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-link {
    color: #64748b;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(99, 102, 241, 0.35),
      rgba(14, 165, 233, 0.35),
      transparent
    );
  }
</style>