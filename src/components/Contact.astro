---
---

<section
  id="contact"
  class="py-24"
  style="background: var(--bg-section); position: relative; z-index: 5; scroll-margin-top: 80px;"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-12 reveal">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
          Contact
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">
          Start a Conversation
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">

        <div class="card reveal" style="transition-delay: 0.1s;">
          <h3 class="text-xl text-white font-semibold mb-4">
            Looking for a stronger growth system?
          </h3>

          <p class="text-slate-400 leading-relaxed mb-5">
            I’m interested in working with teams that want clearer measurement,
            stronger acquisition systems, and better business decisions.
          </p>

          <p class="text-slate-400 leading-relaxed">
            I usually prefer to start with a focused assessment or project,
            prove the opportunity, and expand from there if there’s a strong fit.
          </p>
        </div>

        <div class="card reveal" style="transition-delay: 0.2s;">
          <form
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            class="space-y-4"
          >
        <input type="hidden" name="form-name" value="contact" />
            
            <input
              type="hidden"
              name="subject"
              value="New inquiry from michaelcastro.digital"
            />

            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none;"
              aria-hidden="true"
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label
                  for="name"
                  class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2"
                >
                  Name
                </label>

                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  required
                  class="w-full bg-slate-900/60 border border-slate-700/60 rounded-lg px-4 py-3 text-white text-sm focus:outline-hidden focus-visible:border-accent focus-visible:ring-1 focus-visible:ring-accent/50 transition-colors placeholder:text-slate-600"
                  placeholder="Your name"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2"
                >
                  Email
                </label>

                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  required
                  class="w-full bg-slate-900/60 border border-slate-700/60 rounded-lg px-4 py-3 text-white text-sm focus:outline-hidden focus-visible:border-accent focus-visible:ring-1 focus-visible:ring-accent/50 transition-colors placeholder:text-slate-600"
                  placeholder="you@example.com"
                />
              </div>
            </div>

            <div>
              <label
                for="message"
                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2"
              >
                What are you trying to improve?
              </label>

              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full bg-slate-900/60 border border-slate-700/60 rounded-lg px-4 py-3 text-white text-sm focus:outline-hidden focus-visible:border-accent focus-visible:ring-1 focus-visible:ring-accent/50 transition-colors resize-none placeholder:text-slate-600"
                placeholder="Briefly describe your business, acquisition channels, or measurement challenge."
              ></textarea>
            </div>

            <div aria-live="polite" id="form-status" class="sr-only"></div>

            <button type="submit" class="btn-primary w-full">
              Request a Conversation
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#contact .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }

    const formData = new FormData(form);
    const encoded = new URLSearchParams();

    formData.forEach((value, key) => {
      encoded.append(key, String(value));
    });

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: encoded.toString()
      });

      if (!response.ok) throw new Error('Submission failed');

      form.reset();

      if (status) {
        status.textContent = "Thanks — your message was sent. I'll be in touch soon.";
        status.className = 'mt-4 text-sm text-green-400';
      }
    } catch {
      if (status) {
        status.textContent = 'Something went wrong. Please try again.';
        status.className = 'mt-4 text-sm text-red-400';
      }
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Request a Conversation';
      }
    }
  });

  const BUTTON_TEXT = button?.textContent ?? 'Request a Conversation';

  function setStatus(msg: string, isError: boolean) {
    if (!status) return;
    status.textContent = msg;
    status.className = isError
      ? 'mt-3 text-sm text-red-400'
      : 'mt-3 text-sm text-green-400';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }

    setStatus('', false);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form!)
      });

      const data = await res.json();

      if (res.ok) {
        setStatus("Message sent. I'll be in touch soon.", false);
        form!.reset();
      } else {
        setStatus(data.message ?? 'Something went wrong. Please try again.', true);
      }
    } catch {
      setStatus('Network error. Please try again.', true);
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = BUTTON_TEXT;
      }
    }
  });
</script>

<style>
  :global([data-theme='light']) .text-white {
    color: black;
  }

  :global([data-theme='light']) #contact textarea,
  :global([data-theme='light']) #contact input {
    background: white !important;
  }
</style>